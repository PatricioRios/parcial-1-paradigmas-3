classDiagram
    class Sucursal {
        +String codigoSucursal
        +String direccion
        +String telefono
    }

    class Hotel {
        +String codigoHotel
        +String nombre
        +String direccion
        +String ciudad
        +String telefono
        +Integer numeroPlazasDisponibles
    }

    class Vuelo {
        +String numeroVuelo
        +Date fecha
        +Time hora
        +String origen
        +String destino
        +Integer plazasTotales
        +Integer plazasClaseTurista
        +getPlazasPrimera(): Integer
    }

    class Turista {
        +String codigoTurista
        +String nombre
        +String apellidos
        +String direccion
        +String telefono
    }

    class ContratoViaje {
        +String idContrato
        +Date fechaContrato
    }

    class ReservaVuelo {
        +TipoClaseVuelo claseAsiento
        +Integer cantidadAsientos
    }

    class ReservaHotel {
        +Date fechaLlegada
        +Date fechaPartida
        +TipoRegimenHotel regimenHospedaje
    }

    enum TipoClaseVuelo {
        TURISTA
        PRIMERA
    }

    enum TipoRegimenHotel {
        MEDIA_PENSION
        PENSION_COMPLETA
    }

    %% Relaciones
    Turista "1" -- "0..*" ContratoViaje : realiza
    Sucursal "1" -- "0..*" ContratoViaje : gestiona

    ContratoViaje "1" -- "0..*" ReservaVuelo : incluye
    Vuelo "1" -- "0..*" ReservaVuelo : es_reservado_en

    ContratoViaje "1" -- "0..*" ReservaHotel : incluye
    Hotel "1" -- "0..*" ReservaHotel : es_reservado_en

    ReservaVuelo -- TipoClaseVuelo : usa
    ReservaHotel -- TipoRegimenHotel : usa

    %% Podríamos tener una clase "Agencia" que agrupe sucursales, hoteles y vuelos
    %% pero para simplificar y dado que la info es "de la cadena",
    %% se asume que Sucursal, Hotel y Vuelo son parte de la misma cadena.
    %% Si hubiera múltiples cadenas, se necesitaría una clase Agencia.